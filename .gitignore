# Secrets — never commit these
.env
.env.*
*.key
*.pem
**/secrets.*

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local Claude state (keep skills/agents/teams; ignore machine-local settings)
.claude/settings.local.json
.claude/*.local.json

# ---------------------------------------------------------------------------
# Privacy defaults — ON (fail-safe). New personal files in these dirs never
# enter git. NOTE: the kit's tracked placeholders stay tracked (gitignore does
# not untrack) — the pre-push privacy gate covers those: scripts/rails-guard.sh install
# Keeping a PRIVATE fork and want your context versioned? Comment these out.
context/*
!context/README.md
knowledge/*
!knowledge/README.md
decisions/*
artifacts/*
!artifacts/README.md
# ---------------------------------------------------------------------------
