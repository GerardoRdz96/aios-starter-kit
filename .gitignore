# Secrets — never commit these
.env
.env.*
*.key
*.pem
**/secrets.*

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local Claude state (keep skills/agents/teams; ignore machine-local settings)
.claude/settings.local.json
.claude/*.local.json

